{
  "name": "@bhai/native",
  "version": "0.1.0",
  "description": "Native SIMD-accelerated operations for Bhai",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "private": true,
  "napi": {
    "name": "bhai-native",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js",
    "build:debug": "napi build --platform --js binding.js",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9"
  },
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "index.js",
    "binding.js",
    "index.d.ts",
    "*.node"
  ]
}
