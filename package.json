{
    "name": "atlas",
    "version": "0.2.1",
    "description": "Bhai — lean, secure, personal AI agent",
    "private": true,
    "license": "UNLICENSED",
    "author": "XAGI Labs Private Limited",
    "type": "module",
    "scripts": {
        "predev": "(npm run build:location && npm run build:ax) 2>/dev/null || true",
        "dev": "tsx --watch src/index.ts",
        "build": "node node_modules/typescript/bin/tsc -p tsconfig.prod.json",
        "postbuild": "node scripts/postbuild-copy-assets.mjs",
        "start": "node dist/index.js",
        "build:native": "cd native && npm install && npm run build",
        "build:ocr": "swiftc -O scripts/ocr_screen.swift -o scripts/ocr_screen_bin 2>/dev/null || echo 'Swift OCR compilation skipped (non-macOS or no Swift)'",
        "build:location": "swiftc -O scripts/get_location.swift -o scripts/get_location_bin -framework CoreLocation -framework Foundation -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker scripts/LocationInfo.plist 2>/dev/null || echo 'Swift location helper compilation skipped (non-macOS or no Swift)'",
        "build:ax": "swiftc -O scripts/dump_ax.swift -o scripts/dump_ax_bin 2>/dev/null || echo 'Swift AX helper compilation skipped (non-macOS or no Swift)'",
        "build:helpers": "npm run build:ocr && npm run build:location && npm run build:ax",
        "build:all": "npm run build:native && npm run build:helpers && npm run build",
        "lint": "biome check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:hermetic": "bash scripts/run-tests.sh",
        "test:watch": "vitest",
        "smoke:video": "tsx scripts/video-studio-smoke.ts",
        "release": "node scripts/release.mjs",
        "postinstall": "node scripts/patch-baileys.mjs || true && npx tsx scripts/postinstall-video.ts 2>/dev/null || true"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "0.133.0",
        "@discordjs/voice": "^0.19.2",
        "@google/genai": "^1.49.0",
        "@hapi/boom": "^10.0.1",
        "@huggingface/transformers": "^3.5.1",
        "@modelcontextprotocol/sdk": "^1.9.0",
        "@slack/bolt": "^4.7.0",
        "@supabase/supabase-js": "^2.49.1",
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "@xenova/transformers": "^2.17.2",
        "acorn": "^8.16.0",
        "apify-client": "^2.23.0",
        "better-sqlite3": "^12.11.1",
        "clipboardy": "^4.0.0",
        "convex": "^1.34.0",
        "discord.js": "^14.26.3",
        "dockerode": "^4.0.5",
        "docx": "^9.6.1",
        "docxtemplater": "^3.68.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "ffmpeg-static": "^5.2.0",
        "ffprobe-static": "^3.1.0",
        "fluent-ffmpeg": "^2.1.3",
        "googleapis": "^171.4.0",
        "grammy": "^1.35.0",
        "gray-matter": "^4.0.3",
        "imapflow": "^1.2.12",
        "kokoro-js": "^1.2.1",
        "markdown-it": "^14.1.1",
        "node-cron": "^3.0.3",
        "nodemailer": "^10.2.1",
        "openai": "^7.43.0",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^1.1.1",
        "pizzip": "^3.2.0",
        "playwright": "^1.51.0",
        "pptxgenjs": "^4.0.1",
        "proper-lockfile": "^4.1.2",
        "psl": "^1.15.0",
        "qrcode-terminal": "^0.12.0",
        "resumed": "^6.1.0",
        "screenshot-desktop": "^1.12.7",
        "sharp": "^0.35.5",
        "snoowrap": "^1.23.0",
        "tar": "^7.5.22",
        "tree-sitter": "^0.22.4",
        "tree-sitter-go": "^0.21.2",
        "tree-sitter-python": "^0.21.0",
        "tree-sitter-rust": "^0.21.0",
        "tree-sitter-typescript": "^0.23.2",
        "twitter-api-v2": "^1.29.0",
        "unpdf": "^1.6.0",
        "web-push": "^3.6.7",
        "winreg2": "^1.3.3",
        "ws": "^8.18.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1045.0",
        "@aws-sdk/lib-storage": "^3.1045.0",
        "@biomejs/biome": "^2.4.12",
        "@types/archiver": "^7.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/dockerode": "^3.3.34",
        "@types/express": "^5.0.0",
        "@types/fluent-ffmpeg": "^2.1.27",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^22.13.4",
        "@types/node-cron": "^3.0.11",
        "@types/proper-lockfile": "^4.1.4",
        "@types/snoowrap": "^1.16.1",
        "@types/tar": "^6.1.13",
        "@types/ws": "^8.5.13",
        "@vitest/ui": "^4.1.12",
        "archiver": "^7.0.1",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=20"
    },
    "overrides": {
        "sharp": "^0.35.5",
        "proxy-addr": "^2.0.8",
        "request": {
            "form-data": "^2.5.4"
        },
        "protobufjs": "^7.5.5",
        "basic-ftp": "^6.2.3",
        "image-size": "^2.0.3",
        "snoowrap": {
            "ws": "^5.2.7"
        },
        "qs": "^6.17.0"
    }
}
