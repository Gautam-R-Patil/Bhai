<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron's V8 JIT engine -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Electron / Node.js native addons -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for native modules like better-sqlite3 (unsigned dylibs) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- ─── Microphone (for voice messages and live voice) ── -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- ─── Screen Recording ──────────────────────── -->
    <!-- Allows screencapture / CGWindowListCreateImage/ SCStream to work -->
    <key>com.apple.security.device.screen-recording</key>
    <true/>
    <!-- ─── Accessibility (for mouse/click simulation) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
