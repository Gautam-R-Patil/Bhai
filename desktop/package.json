{
    "name": "bhai-desktop",
    "version": "0.2.1",
    "description": "Bhai AI — Desktop Control Panel & Installer",
    "author": "XAGI Labs Private Limited",
    "license": "UNLICENSED",
    "private": true,
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "test": "vitest run",
        "prebuild": "echo 'Source protection will run after pack...'",
        "build:win": "cd .. && npm run build && cd desktop && node build/patch-nsis.js && electron-builder --win --x64",
        "build:mac": "cd .. && npm run build:helpers && test -x scripts/dump_ax_bin -a -x scripts/ocr_screen_bin -a -x scripts/get_location_bin && npm run build && cd desktop && electron-builder --mac --dir --arm64 && bash build/resign-local.sh && ARCH=arm64 bash build/create-dmg.sh",
        "build:mac:release": "cd .. && npm run build:helpers && test -x scripts/dump_ax_bin -a -x scripts/ocr_screen_bin -a -x scripts/get_location_bin && npm run build && cd desktop && electron-builder --mac dmg",
        "build:mac:protected": "cd .. && npm run build:helpers && test -x scripts/dump_ax_bin -a -x scripts/ocr_screen_bin -a -x scripts/get_location_bin && npm run build && cd desktop && npm run prebuild && electron-builder --mac",
        "build:linux": "cd .. && npm run build && cd desktop && electron-builder --linux",
        "build:win:protected": "cd .. && npm run build && cd desktop && node build/patch-nsis.js && npm run prebuild && electron-builder --win --x64",
        "postinstall": "electron-builder install-app-deps",
        "protect:standalone": "node build/obfuscate.js ../dist ../dist-obfuscated && node build/compile-bytecode.js --in-place ../dist-obfuscated"
    },
    "dependencies": {
        "adm-zip": "^0.6.1",
        "better-sqlite3": "^12.11.1",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.1.7",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "bytenode": "^1.5.7",
        "electron": "^42.11.18",
        "electron-builder": "^26.8.1",
        "esbuild": "^0.28.0",
        "javascript-obfuscator": "^4.1.1",
        "jsdom": "^29.0.2",
        "vitest": "^4.1.12"
    },
    "build": {
        "appId": "com.xagilabs.bhai",
        "productName": "Bhai",
        "copyright": "Copyright © 2024-2026 XAGI Labs Private Limited. All rights reserved.",
        "publish": {
            "provider": "generic",
            "url": "https://avid-finch-726.convex.site/api/updates",
            "useMultipleRangeRequest": false
        },
        "asar": true,
        "asarUnpack": [
            "node_modules/better-sqlite3/**",
            "node_modules/@xenova/**",
            "node_modules/sharp/**",
            "native/*.node"
        ],
        "files": [
            "**/*",
            "!build/**",
            "!tests/**",
            "!demo/**",
            "!onboarding-demo/**",
            "!**/*.test.js",
            "!**/*.spec.js",
            "!**/*.test.ts",
            "!**/*.spec.ts",
            "!vitest.config.js",
            "!vitest.config.ts"
        ],
        "extraResources": [
            {
                "from": "../dist",
                "to": "bot/dist",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../package.json",
                "to": "bot/package.json"
            },
            {
                "from": "../scripts",
                "to": "bot/scripts",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../chrome-extension",
                "to": "chrome-extension",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../site-skills",
                "to": "bot/site-skills",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../skills/templates",
                "to": "bot/skills/templates",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../models",
                "to": "bot/models",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../src/overlay/overlay.html",
                "to": "bot/src/overlay/overlay.html"
            },
            {
                "from": "../native",
                "to": "bot/native",
                "filter": [
                    "index.js",
                    "binding.js",
                    "*.node",
                    "package.json"
                ]
            },
            {
                "from": "../node_modules",
                "to": "bot/node_modules",
                "filter": [
                    "**/*",
                    "!.bin/**",
                    "!@biomejs/**",
                    "!@types/**",
                    "!@vitest/**",
                    "!archiver/**",
                    "!biome/**",
                    "!jsdoc-to-markdown/**",
                    "!jsdom/**",
                    "!tsx/**",
                    "!typescript/**",
                    "!vitest/**",
                    "!**/*.d.ts.map",
                    "!**/*.md",
                    "!**/*.markdown",
                    "!**/CHANGELOG*",
                    "!**/CONTRIBUTING*",
                    "!**/test/**",
                    "!**/tests/**",
                    "!**/__tests__/**",
                    "playwright/lib/mcp/test/**",
                    "playwright-core/lib/mcp/test/**",
                    "!**/*.test.js",
                    "!**/*.spec.js",
                    "!**/.github/**",
                    "!**/examples/**",
                    "!**/example/**",
                    "!**/ort-wasm*.wasm",
                    "!ffprobe-static/bin/**",
                    "!onnxruntime-node/bin/**",
                    "!**/onnxruntime-node/bin/**"
                ]
            }
        ],
        "win": {
            "signtoolOptions": {
                "signingHashAlgorithms": [
                    "sha256"
                ]
            },
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "logo.ico",
            "legalTrademarks": "© 2024-2026 XAGI Labs Private Limited. All rights reserved.",
            "requestedExecutionLevel": "asInvoker",
            "extraResources": [
                {
                    "from": "../node_modules/ffprobe-static/bin/win32",
                    "to": "bot/node_modules/ffprobe-static/bin/win32"
                },
                {
                    "from": "../node_modules/onnxruntime-node/bin/napi-v3/win32",
                    "to": "bot/node_modules/onnxruntime-node/bin/napi-v3/win32"
                },
                {
                    "from": "../node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/win32",
                    "to": "bot/node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/win32"
                }
            ]
        },
        "mac": {
            "identity": "-",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "notarize": false,
            "target": [
                "dir"
            ],
            "icon": "build/icon-mac.png",
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSMicrophoneUsageDescription": "Bhai needs microphone access for voice messages and live voice conversations.",
                "NSScreenCaptureUsageDescription": "Bhai needs screen recording access to take screenshots and help you with screen-based tasks.",
                "NSAppleEventsUsageDescription": "Bhai uses Apple Events to automate actions on your Mac."
            },
            "extraResources": [
                {
                    "from": "../node_modules/onnxruntime-node/bin/napi-v3/darwin/${arch}",
                    "to": "bot/node_modules/onnxruntime-node/bin/napi-v3/darwin/${arch}"
                },
                {
                    "from": "../node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/darwin/${arch}",
                    "to": "bot/node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/darwin/${arch}"
                }
            ]
        },
        "dmg": {
            "title": "Bhai Setup",
            "icon": "build/icon-mac.png",
            "background": "build/dmg-background@2x.png",
            "sign": true,
            "writeUpdateInfo": true,
            "window": {
                "width": 540,
                "height": 380
            },
            "contents": [
                {
                    "x": 130,
                    "y": 150,
                    "type": "file"
                },
                {
                    "x": 410,
                    "y": 150,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "logo.ico",
            "uninstallerIcon": "logo.ico",
            "installerHeaderIcon": "logo.ico",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "runAfterFinish": true,
            "shortcutName": "Bhai",
            "license": "../LICENSE.txt",
            "include": "./build/installer.nsh"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "logo.png",
            "category": "Utility",
            "synopsis": "A continuously running, proactive personal AI agent.",
            "description": "Bhai is an autonomous AI assistant with persistent memory, multi-channel presence (Telegram, Discord, Slack, WhatsApp, email), browsing, deep research and coding capabilities. Privacy-first: server-side prompts, end-to-end encrypted transport, your conversations are never used to train foundation models.",
            "extraResources": [
                {
                    "from": "../node_modules/ffprobe-static/bin/linux",
                    "to": "bot/node_modules/ffprobe-static/bin/linux"
                },
                {
                    "from": "../node_modules/onnxruntime-node/bin/napi-v3/linux",
                    "to": "bot/node_modules/onnxruntime-node/bin/napi-v3/linux"
                },
                {
                    "from": "../node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/linux",
                    "to": "bot/node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/linux"
                }
            ]
        },
        "deb": {
            "depends": [
                "libgtk-3-0",
                "libnotify4",
                "libnss3",
                "libxss1",
                "libxtst6",
                "xdg-utils",
                "libatspi2.0-0",
                "libuuid1",
                "libsecret-1-0"
            ]
        },
        "appImage": {
            "license": "../LICENSE.txt"
        },
        "afterPack": "./build/protect-source.js"
    }
}
