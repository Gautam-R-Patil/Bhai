# Convex
NEXT_PUBLIC_CONVEX_URL=https://zany-kudu-607.convex.cloud

# JWT Secret for admin sessions (generate a random 64-char string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-64-chars

# Initial Super Admin (create on first run)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change-this-password

# ── ATLAS Admin API (required by the Observability dashboard) ──
# The observability page calls admin-gated httpActions on the ATLAS
# backend. NEXT_PUBLIC_ATLAS_ADMIN_KEY must match process.env.ADMIN_API_KEY
# on the Convex side. NEXT_PUBLIC_ATLAS_ADMIN_API_BASE is optional and
# defaults to <CONVEX_URL>.convex.site (cloud) for httpAction routing.
NEXT_PUBLIC_ATLAS_ADMIN_KEY=paste-the-same-key-as-ADMIN_API_KEY-on-convex
NEXT_PUBLIC_ATLAS_ADMIN_API_BASE=https://zany-kudu-607.convex.site
