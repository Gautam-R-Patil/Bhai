# Convex (production by default — flip to https://zany-kudu-607.convex.cloud for dev)
NEXT_PUBLIC_CONVEX_URL=https://avid-oyster-465.convex.cloud

# JWT Secret for admin sessions (generate a random 64-char string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-64-chars

# Initial Super Admin (create on first run)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change-this-password

# ── Bhai Admin API (required by the Observability dashboard) ──
# The observability page calls admin-gated httpActions on the Bhai
# backend. ATLAS_ADMIN_KEY must match process.env.ADMIN_API_KEY
# on the Convex side. NEXT_PUBLIC_ATLAS_ADMIN_API_BASE is optional and
# defaults to <CONVEX_URL>.convex.site (cloud) for httpAction routing.
#
# IMPORTANT: ATLAS_ADMIN_KEY is intentionally NOT NEXT_PUBLIC_*. Next.js
# inlines any NEXT_PUBLIC_* variable into every client bundle at build
# time — leaking the master admin key to every browser visitor. Keep
# this strictly server-side.
ATLAS_ADMIN_KEY=paste-the-same-key-as-ADMIN_API_KEY-on-convex
NEXT_PUBLIC_ATLAS_ADMIN_API_BASE=https://avid-oyster-465.convex.site

# ── Atlas-mcp (Enterprise) Admin API ──
# The /enterprise page in the admin panel manages Bhai Tools MCP customer
# licenses on the isolated enterprise Convex deployment. These two vars are
# SERVER-SIDE only (never NEXT_PUBLIC_*). Keys must match the ADMIN_API_KEY
# set on the corresponding Atlas-mcp Convex deployment.
#
# Prod: https://sincere-caiman-611.convex.site
# Dev:  https://little-chinchilla-649.convex.site
ATLAS_MCP_CONVEX_SITE_URL=https://sincere-caiman-611.convex.site
ATLAS_MCP_ADMIN_KEY=paste-the-prod-Atlas-mcp-admin-key-here
