# ──────────────────────────────────────────────
# A.T.L.A.S — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Required: Telegram Bot ────────────────────
# Create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs
# Find yours by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=your_user_id_here

# ── Optional: Email Integration ───────────────
# IMAP/SMTP credentials for A.T.L.A.S's email account
# Leave empty to disable email features
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_password_here

# Comma-separated list of whitelisted email addresses
# Only these senders can message A.T.L.A.S via email
EMAIL_WHITELIST=your_email@example.com

# ── Optional: WhatsApp Channel ────────────────
# Comma-separated WhatsApp JIDs to allow (e.g., 919876543210@s.whatsapp.net)
# Leave empty to disable WhatsApp channel
# Find your JID: it's your phone number (with country code, no +) followed by @s.whatsapp.net
WHATSAPP_ALLOWED_JIDS=

# ── Optional: Discord Bot ────────────────────
# Create a bot at https://discord.com/developers/applications
# Enable MESSAGE CONTENT intent in the Bot settings
# Leave empty to disable Discord channel
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Comma-separated Discord user IDs to allow (leave empty to allow all server members)
DISCORD_ALLOWED_USER_IDS=
# Channel ID for proactive notifications (leave empty to disable)
DISCORD_NOTIFICATIONS_CHANNEL_ID=

# ── Optional: Slack Bot ──────────────────────
# Create a Slack app at https://api.slack.com/apps
# Enable Socket Mode and add the bot to your workspace
# Leave empty to disable Slack channel
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs to allow (leave empty to allow all)
SLACK_ALLOWED_USER_IDS=
# Default channel for proactive messages (channel ID, not name)
SLACK_DEFAULT_CHANNEL=

# ── Optional: Matrix / Element ───────────────
# Self-hosted Matrix server for federated messaging
# Leave empty to disable Matrix channel
MATRIX_HOMESERVER=
MATRIX_USER_ID=
MATRIX_PASSWORD=
# Comma-separated room IDs to listen in (e.g., !abc123:matrix.org)
MATRIX_ALLOWED_ROOMS=

# ── Optional: Primary Channel ────────────────
# Primary channel for proactive messages (morning briefs, reminders, task completions)
# Options: telegram, whatsapp, discord, slack, overlay, email, matrix
# Default: telegram
PRIMARY_CHANNEL=telegram

# ── Optional: Web Widget ─────────────────────
# Token for authenticating web widget connections
# Set this to a random string if you want to embed the chat widget on a website
# Leave empty to allow unauthenticated widget connections (localhost only)
WIDGET_TOKEN=

# ── Optional: GitHub Integration ──────────────
# Personal access token for GitHub features
# Leave empty to disable GitHub integration
GITHUB_TOKEN=your_github_token_here

# ── Optional: Embedding Model ────────────────
# Choose which embedding model to use for semantic memory:
#   "minilm"  → Xenova/all-MiniLM-L6-v2, 384-dim, ~33MB, no auth needed (default)
#   "nomic"   → nomic-ai/nomic-embed-text-v1.5, 768-dim Matryoshka→256-dim, ~274MB, needs HF_TOKEN
# Changing this after initial use triggers automatic re-embedding of stored memories.
ATLAS_EMBEDDING_MODEL=minilm

# ── Optional: HuggingFace Token ──────────────
# Required for gated embedding models (nomic-embed-text-v1.5)
# Without this, A.T.L.A.S falls back to a smaller model
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Optional: Live Voice Mode ────────────────
# Voice preferences (non-secret, local only)
# LIVE_VOICE_NAME=          # Gemini: Aoede/Charon/Kore/Fenrir/Puck, OpenAI: alloy/shimmer/echo
# LIVE_VOICE_BACKEND=       # Force: gemini-live | openai-realtime | hybrid (auto-detect if empty)
# Note: GOOGLE_API_KEY and OPENAI_API_KEY are stored in Convex env vars (server-side)

# ── Optional: Location Service ───────────────
# Automatic device location detection (GPS → Wi-Fi → IP fallback)
# Used for weather, timezone, and location-aware proactive features
# Set to "false" to disable location detection entirely
# LOCATION_ENABLED=true

# ────────────────────────────────────────────────────────────
# Proactive Subsystem Kill Switches (all default OFF = enabled)
# ────────────────────────────────────────────────────────────
# ATLAS_PROACTIVE_DISABLE=true              # emergency global mute
# ATLAS_PROACTIVE_DISABLE_SOURCES=memory_anticipation,env_context
# ATLAS_PROACTIVE_DISABLE_CHANNELS=whatsapp,telegram
# ATLAS_PROACTIVE_SHADOW=true               # runs pipeline, logs decisions, doesn't send
# Proactive subsystem debug logging. Logs go to stdout AND to
# data/logs/proactive-<date>.log (7-day retention). Disable with:
# ATLAS_PROACTIVE_DEBUG=false               # silence debug event logs
# ATLAS_PROACTIVE_V2_COMPOSER=true          # Phase 1 flag (default ON)
# ATLAS_PROACTIVE_V2_SCHEDULER=true         # Phase 2 flag (default ON)
# ATLAS_PROACTIVE_V2_INBOX=true             # Phase 4 flag

# ── Note on API Keys ──────────────────────────
# OpenRouter and Convex keys are bundled with the app.
# You don't need to provide them - they're already included.
